{
  "name": "jaylog-mcp",
  "version": "0.1.3",
  "description": "Model Context Protocol server for Jaylog observability (logs, metrics, services, schedules)",
  "bin": {
    "jaylog-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "login": "bun src/index.ts login",
    "logout": "bun src/index.ts logout",
    "build": "tsc && chmod +x dist/*.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "jaylog",
    "mcp",
    "observability",
    "claude"
  ],
  "author": "gpocas",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}

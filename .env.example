# Base URL of the backend-nn-analytics API
JAYLOG_API_BASE_URL=http://localhost:3000

# Base URL of the frontend-analytics-logging app, used only by `bun run login`
# to open the browser consent screen (/mcp/authorize). Falls back to
# JAYLOG_API_BASE_URL if unset, which is fine when frontend and API share an
# origin (e.g. behind the same reverse proxy).
JAYLOG_FRONTEND_URL=http://localhost:3000

# Optional: explicit token override, takes precedence over the credential
# saved by `bun run login`. Handy for CI or scripting; any profile >= guest
# works for the read-only tools in this server. Get one by logging into the
# app and generating a personal token under "Tokens MCP", or just run
# `bun run login` instead.
JAYLOG_API_TOKEN=

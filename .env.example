# URL of the Jaylog web app (frontend-analytics-logging). With only this set,
# `login` opens <JAYLOG_URL>/mcp/authorize and the tools call the API through
# the web app's proxy at <JAYLOG_URL>/proxy/*.
JAYLOG_URL=https://your-jaylog-app

# Local development, where the backend (:3000) and the web app (:3001) run on
# different ports and you want to skip the proxy: set these two instead.
# JAYLOG_API_BASE_URL takes precedence over JAYLOG_URL for API calls;
# JAYLOG_FRONTEND_URL takes precedence over it for `login`.
# JAYLOG_API_BASE_URL=http://localhost:3000
# JAYLOG_FRONTEND_URL=http://localhost:3001

# Optional: explicit token override, takes precedence over the credential
# saved by `bun run login`. Handy for CI or scripting; any profile >= guest
# works for the read-only tools in this server. Get one by logging into the
# app and generating a personal token under "Tokens MCP", or just run
# `bun run login` instead.
JAYLOG_API_TOKEN=
